{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/post-edit.ps1",
            "timeout": 30,
            "statusMessage": "rustfmt + character check"
          }
        ]
      }
    ]
  }
}
